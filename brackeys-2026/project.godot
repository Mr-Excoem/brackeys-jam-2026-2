; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Brackeys_2026"
run/main_scene="uid://coed57jgpcf01"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BombTimer="*uid://b0guxfbjkl43o"
MouseParallax="*uid://c71onab1qpyfa"

[display]

window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://xn1dso4km1x2"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "red",
"res://bomb_scenes/": "orange",
"res://scenes/": "green",
"res://scripts/": "purple"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.27450982, 0.2901961, 0.54901963, 1)
